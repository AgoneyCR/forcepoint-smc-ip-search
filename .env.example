# =====================================================================
# Forcepoint SMC IP Search - Environment Configuration Template
# =====================================================================
# Copia este archivo a .env y completa los valores correspondientes:
#   cp .env.example .env
#
# ADVERTENCIA: NUNCA subas tu archivo .env con credenciales a Git.
# =====================================================================

# Dirección IP o URL del Forcepoint SMC (Management Center)
# Si no incluye esquema ni puerto, se asumirá por defecto https://<SMC_URL>:8082
SMC_URL=https://smc.example.com:8082

# API Key generada en el Forcepoint SMC con permisos de lectura
SMC_API_KEY=your_smc_api_key_here

# Nombre del grupo principal en el SMC donde se realizarán las búsquedas
SMC_GROUP=Mi_Grupo_Ejemplo

# Verificación de certificados SSL (true/false)
# Por defecto en entornos corporativos con certificados autofirmados suele ser false.
SMC_SSL_VERIFY=false
